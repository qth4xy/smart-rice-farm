    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "mqtt": "5.16.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uplot": "1.6.32"
  }
